# Copie para .env e substitua apenas por valores do MySQL LOCAL de desenvolvimento.
NODE_ENV=development
SUPPORTDESK_LOCAL_TESTS=1
DEV_DB_CONFIRM=I_UNDERSTAND_LOCAL_DATABASE_ONLY

PORT=3000
FRONTEND_URL=http://127.0.0.1:5173

DB_HOST=127.0.0.1
